# ==============================================================================
# Android Release Signing Properties Template
# ==============================================================================
# Copy this file to `android/key.properties` and fill in your actual keystore credentials:
#   cp android/key.properties.example android/key.properties
#
# IMPORTANT SECURITY NOTES:
# 1. NEVER commit `key.properties`, `*.jks`, or `*.keystore` files to version control!
# 2. Both `android/key.properties` and `*.jks` / `*.keystore` are ignored by git.
# 3. Keep a safe, offline backup of your release keystore and credentials.
#
# If you do not have a keystore yet, generate one with keytool:
#   keytool -genkey -v -keystore android/app/upload-keystore.jks \
#           -keyalg RSA -keysize 2048 -validity 10000 -alias upload
#
# If your keystore is placed in `android/app/upload-keystore.jks`:
#   storeFile=upload-keystore.jks
# Or provide the absolute path:
#   storeFile=/path/to/upload-keystore.jks
# ==============================================================================

keyAlias=upload
keyPassword=YOUR_KEY_PASSWORD
storeFile=upload-keystore.jks
storePassword=YOUR_STORE_PASSWORD
